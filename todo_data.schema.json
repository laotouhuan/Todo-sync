{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TodoData",
  "description": "Schema for Nutstore To-Do App Data",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Data schema version"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last updated timestamp in ISO 8601 format"
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "completed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification timestamp, used for cloud sync conflict resolution"
          },
          "deleted": {
            "type": "boolean",
            "default": false,
            "description": "Soft-delete flag"
          },
          "recurring": {
            "type": "string",
            "enum": [
              "none",
              "daily_repeat"
            ],
            "default": "none"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "normal",
              "weekly_checkin",
              "monthly_checkin"
            ],
            "default": "normal"
          },
          "completed_dates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "target_count": {
            "type": [
              "integer",
              "null"
            ],
            "default": null
          },
          "reminder": {
            "type": [
              "object",
              "null"
            ],
            "default": null,
            "description": "Single task reminder configuration",
            "properties": {
              "reminder_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reminder_time": {
                "type": "string"
              },
              "repeat_daily": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "reminder_time"
            ]
          },
          "subtasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "content": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean"
                },
                "completed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "default": null
                }
              },
              "required": [
                "id",
                "content",
                "completed"
              ]
            },
            "default": []
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "任务的唯一标签；空值为未分类"
          }
        },
        "required": [
          "id",
          "content",
          "completed",
          "created_at"
        ]
      }
    },
    "reminder_settings": {
      "type": "object",
      "properties": {
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null,
          "description": "Last reminder settings modification timestamp, independent from todo data changes"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "privacy_mode": {
          "type": "boolean",
          "default": false
        },
        "global_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "time": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "enum": [
                  "none_completed",
                  "any_remaining",
                  "unconditional"
                ],
                "default": "unconditional"
              },
              "task_scope": {
                "type": "string",
                "enum": [
                  "all",
                  "today_only",
                  "recurring_only"
                ],
                "default": "all"
              },
              "title": {
                "type": "string",
                "default": ""
              },
              "body": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "id",
              "time",
              "condition",
              "task_scope",
              "body"
            ]
          },
          "default": []
        }
      }
    },
    "time_entries": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "task_ref": {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "enum": [
                  "personal",
                  "collaboration"
                ],
                "default": "personal"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "todo_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "todo_id"
            ]
          },
          "task_content_snapshot": {
            "type": "string",
            "default": ""
          },
          "label_snapshot": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "task_ref",
          "started_at",
          "created_at",
          "updated_at"
        ]
      }
    },
    "daily_reviews": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "fact": {
            "type": "string",
            "default": ""
          },
          "obstacle": {
            "type": "string",
            "default": ""
          },
          "effective_action": {
            "type": "string",
            "default": ""
          },
          "next_step": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "id",
          "date",
          "created_at",
          "updated_at"
        ]
      }
    }
  },
  "required": [
    "version",
    "last_updated",
    "todos"
  ]
}
