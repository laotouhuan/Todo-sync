{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TodoData",
  "description": "Schema for Nutstore To-Do App Data",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Data schema version"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Last updated timestamp in ISO 8601 format"
    },
    "weekly_plan_versions": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/weeklyPlanVersion" }
    },
    "weekly_plan_selections": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/weeklyPlanSelection" }
    },
    "daily_ratings": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/dailyRating" }
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "completed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification timestamp, used for cloud sync conflict resolution"
          },
          "deleted": {
            "type": "boolean",
            "default": false,
            "description": "Soft-delete flag"
          },
          "recurring": {
            "type": "string",
            "enum": [
              "none",
              "daily_repeat"
            ],
            "default": "none",
            "description": "daily_repeat 仅用于旧数据兼容；新版按 task_type 使用任务，不再自动生成每日副本。"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "normal",
              "weekly_checkin",
              "monthly_checkin"
            ],
            "default": "normal"
          },
          "completed_dates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "target_count": {
            "type": [
              "integer",
              "null"
            ],
            "default": null
          },
          "reminder": {
            "type": [
              "object",
              "null"
            ],
            "default": null,
            "description": "Single task reminder configuration",
            "properties": {
              "reminder_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reminder_time": {
                "type": "string"
              },
              "repeat_daily": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "reminder_time"
            ]
          },
          "subtasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "content": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean"
                },
                "completed_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time",
                  "default": null
                }
              },
              "required": [
                "id",
                "content",
                "completed"
              ]
            },
            "default": []
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "任务的唯一标签；空值为未分类"
          }
        },
        "required": [
          "id",
          "content",
          "completed",
          "created_at"
        ]
      }
    },
    "reminder_settings": {
      "type": "object",
      "properties": {
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "default": null,
          "description": "Last reminder settings modification timestamp, independent from todo data changes"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "privacy_mode": {
          "type": "boolean",
          "default": false
        },
        "global_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "time": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "enum": [
                  "none_completed",
                  "any_remaining",
                  "unconditional"
                ],
                "default": "unconditional"
              },
              "task_scope": {
                "type": "string",
                "enum": [
                  "all",
                  "today_only",
                  "recurring_only"
                ],
                "default": "all"
              },
              "title": {
                "type": "string",
                "default": ""
              },
              "body": {
                "type": "string",
                "default": ""
              }
            },
            "required": [
              "id",
              "time",
              "condition",
              "task_scope",
              "body"
            ]
          },
          "default": []
        }
      }
    },
    "time_entries": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "task_ref": {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "enum": [
                  "personal",
                  "collaboration"
                ],
                "default": "personal"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "todo_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "todo_id"
            ]
          },
          "task_content_snapshot": {
            "type": "string",
            "default": ""
          },
          "label_snapshot": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "task_ref",
          "started_at",
          "created_at",
          "updated_at"
        ]
      }
    },
    "daily_reviews": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "fact": {
            "type": "string",
            "default": ""
          },
          "obstacle": {
            "type": "string",
            "default": ""
          },
          "effective_action": {
            "type": "string",
            "default": ""
          },
          "next_step": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "id",
          "date",
          "created_at",
          "updated_at"
        ]
      }
    },
    "task_series": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "content_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_renamed": {
            "type": "boolean",
            "default": false
          },
          "period_type": {
            "type": "string",
            "enum": [
              "week",
              "month"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "deleted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null
          }
        },
        "required": [
          "id",
          "content",
          "content_updated_at",
          "period_type",
          "created_at",
          "updated_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "deleted": {
                  "const": true
                }
              },
              "required": [
                "deleted"
              ]
            },
            "then": {
              "properties": {
                "deleted_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "deleted_at"
              ]
            }
          }
        ]
      }
    },
    "task_series_links": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "todo_id": {
            "type": "string",
            "format": "uuid"
          },
          "series_id": {
            "type": "string",
            "format": "uuid"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(W\\d{2}|\\d{2})$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean",
            "default": false
          },
          "next_series_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "default": null
          }
        },
        "required": [
          "todo_id",
          "series_id",
          "period",
          "created_at",
          "updated_at"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "deleted": {
                  "const": true
                }
              },
              "required": [
                "deleted"
              ]
            },
            "then": {
              "properties": {
                "next_series_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "next_series_id"
              ]
            },
            "else": {
              "properties": {
                "next_series_id": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "recordId": { "type": "string", "format": "uuid" },
    "calendarDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "instant": { "type": "string", "format": "date-time" },
    "weeklyPlanVersion": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/recordId" },
        "week_start": { "$ref": "#/definitions/calendarDate" },
        "base_version_id": { "type": ["string", "null"], "format": "uuid", "default": null },
        "days": { "type": "array", "items": { "type": "string" }, "minItems": 7, "maxItems": 7, "default": ["", "", "", "", "", "", ""] },
        "change_reason": { "type": "string", "default": "" },
        "created_at": { "$ref": "#/definitions/instant" },
        "updated_at": { "$ref": "#/definitions/instant" },
        "deleted": { "type": "boolean", "default": false },
        "deleted_at": { "type": ["string", "null"], "format": "date-time", "default": null }
      },
      "required": ["id", "week_start", "created_at", "updated_at"]
    },
    "weeklyPlanSelection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/recordId" },
        "week_start": { "$ref": "#/definitions/calendarDate" },
        "version_id": { "$ref": "#/definitions/recordId" },
        "parent_selection_ids": { "type": "array", "items": { "$ref": "#/definitions/recordId" }, "uniqueItems": true, "default": [] },
        "kind": { "enum": ["save", "resolve"], "default": "save" },
        "created_at": { "$ref": "#/definitions/instant" },
        "updated_at": { "$ref": "#/definitions/instant" }
      },
      "required": ["id", "week_start", "version_id", "created_at", "updated_at"]
    },
    "dailyRating": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/recordId" },
        "date": { "$ref": "#/definitions/calendarDate" },
        "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5, "default": null },
        "created_at": { "$ref": "#/definitions/instant" },
        "updated_at": { "$ref": "#/definitions/instant" },
        "deleted": { "type": "boolean", "default": false }
      },
      "required": ["id", "date", "created_at", "updated_at"]
    }
  },
  "required": [
    "version",
    "last_updated",
    "todos"
  ]
}
